{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Media": {
    "RootPath": "../../media"
  },
  "Mail": {
    "From": "portal@localhost"
  },
  "Weather": { "OpenMeteoUrl": "https://api.open-meteo.com", "OpenMeteoMarineUrl": "https://marine-api.open-meteo.com" },
  "Xweather": { "MapsUrl": "https://maps.api.xweather.com" },
  "Depths": { "SeascapeUrl": "https://tiles.openwaters.io/seascape", "Zoom": 12 },
  "Tides": { "OpenWatersUrl": "https://api.openwaters.io/tides", "MaxStationKm": 60 },
  "Map": {
    "StyleUrl": "https://tiles.openfreemap.org/styles/liberty",
    "SeamarkTilesUrl": "/tiles/seamark/{z}/{x}/{y}.mvt",
    "Attribution": "© OpenStreetMap-Mitwirkende · OpenSeaMap · OpenFreeMap",
    "BasemapFile": "../../media/tiles/basemap.pmtiles",
    "KeepRemoteRaster": true
  },
  "Routing": {
    "LandPolygonsUrl": "https://osmdata.openstreetmap.de/download/land-polygons-split-4326.zip",
    "CachePath": "../../media/cache",
    "Region": { "MinLng": 4.5, "MinLat": 52.0, "MaxLng": 19.5, "MaxLat": 60.0 },
    "StartCellM": 20000,
    "MinCellM": 150,
    "TileCells": 10,
    "HarbourAccessM": 3000,
    "CoastPenaltyFactor": 0.2,
    "PassageCostFactor": 1.0,
    "LockPenaltyM": 1852,
    "BridgeOpeningPenaltyM": 926,
    "ChannelPreferenceM": 1500,
    "PassageLinkM": 600,
    "ChannelPenaltyFactor": 3,
    "CardinalPenaltyFactor": 3,
    "MaxRouteNm": 500
  }
}
